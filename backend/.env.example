# Copy this file to .env.local and fill in your own values.
# .env* is gitignored — never commit real secrets.

# The web frontend's real deployed URL (e.g. https://listen.vercel.app, or
# http://localhost:3000 for local dev). Used only to build absolute
# redirect targets for the Google OAuth flow (the redirect_uri sent to
# Google, and where the browser lands after login/failure) — this backend
# has no pages of its own to redirect to.
FRONTEND_URL=http://localhost:3000

# TTSReader (https://ttsreader.com) — get your own key from their dashboard.
TTS_API_KEY=
TTS_API_URL=
TTS_DEFAULT_LANG=
TTS_QUALITY=

# MongoDB (e.g. MongoDB Atlas) — documents, audio metadata, and generated
# MP3s (via GridFS) all live here. Create a free cluster at
# https://www.mongodb.com/cloud/atlas and paste its connection string below.
MONGODB_URI=
MONGODB_DB=

# Google OAuth ("Continue with Google") — create a Web application OAuth
# client at https://console.cloud.google.com/apis/credentials and add these
# authorized redirect URIs (the *frontend's* domain — see FRONTEND_URL above,
# requests to it are proxied through to this backend by web/next.config.mjs):
#   http://localhost:3000/api/auth/google/callback
#   https://<your-production-frontend-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
