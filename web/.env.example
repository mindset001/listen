# Copy this file to .env.local and fill in your own values.
# .env* is gitignored — never commit real secrets.

# TTSReader (https://ttsreader.com) — get your own key from their dashboard.
# The key that shipped in this design-handoff bundle's README was posted in a
# chat message and must be treated as burned. Do not reuse it.
TTS_API_KEY=
TTS_API_URL=https://ttsreader.com/api
TTS_DEFAULT_LANG=en-US
TTS_QUALITY=48khz_192kbps

# MongoDB (e.g. MongoDB Atlas) — documents, audio metadata, and generated
# MP3s (via GridFS) all live here. Create a free cluster at
# https://www.mongodb.com/cloud/atlas and paste its connection string below.
MONGODB_URI=
MONGODB_DB=listen
