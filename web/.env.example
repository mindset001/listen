# Copy this file to .env.local and fill in your own values.
# .env* is gitignored — never commit real secrets.

# The backend now lives in its own service (see ../backend/) — this app
# only proxies /api/* through to it (see next.config.mjs). Point this at
# the backend's local dev server, or its real deployed Render URL.
BACKEND_URL=http://localhost:4000
